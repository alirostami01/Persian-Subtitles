# Server Configuration
SERVER_IP=your-server-ip-or-domain
PORT=7000

# SubSource API Key (required)
API_KEY=your-api-key-here

# Timeout Settings (milliseconds)
LONG_TIMEOUT=60000
SHORT_TIMEOUT=15000

# Clustering Configuration (for high concurrency)
CLUSTER_ENABLED=true
WORKER_COUNT=0

# Rate Limiting (optional, for DDoS protection)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# Connection Pool Settings
MAX_SOCKETS=50
MAX_FREE_SOCKETS=256

# Cache Settings (Redis - optional)
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Subtitle Promotional Text Configuration
# Text to add to subtitles (Persian support message)
SUBTITLE_PROMO_TEXT=❤️ 🎬با حمایت شما، توسعه افزونه ادامه پیدا می‌کند 🙏👉 helpserver.ir/x
# Duration in seconds for how long the text appears on screen
SUBTITLE_PROMO_DURATION=20
# Position: 'start' to add at beginning, 'end' to add at end of subtitle
SUBTITLE_PROMO_POSITION=end
